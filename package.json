{
  "name": "slimeworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "contracts:build": "cd contracts && for c in slime_nft items_mt town; do (cd $c && cargo near build non-reproducible-wasm) || exit 1; done",
    "contracts:test": "cd contracts && cargo test -p slime_nft -p items_mt -p town",
    "contracts:deploy": "tsx scripts/deploy-contracts.ts"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@privy-io/react-auth": "3.51.4",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "near-api-js": "7.5.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
