{
  "name": "slimeworld",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_USE_ENV_PROXY=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "contracts:build": "cd contracts && for c in slime_nft items_mt town goo; do (cd $c && cargo near build non-reproducible-wasm) || exit 1; done",
    "contracts:test": "cd contracts && cargo test -p slime_nft -p items_mt -p town -p goo",
    "contracts:deploy": "tsx scripts/deploy-contracts.ts",
    "art:slime": "blender -b -P art/blender/make_slime.py -- .slime.raw.glb art/slime-preview.png && gltf-transform optimize .slime.raw.glb public/models/slime.glb --compress meshopt --join false --flatten false --instance false --palette false && rm .slime.raw.glb",
    "sim": "tsx --tsconfig tsconfig.json src/sim/cli.ts",
    "ticker": "NODE_USE_ENV_PROXY=1 tsx --tsconfig tsconfig.json scripts/ticker.ts",
    "mind:check": "NODE_USE_ENV_PROXY=1 tsx --tsconfig tsconfig.json scripts/mind-check.ts",
    "check:gasless": "tsx --tsconfig tsconfig.json scripts/gasless-check.ts",
    "chain:setup": "tsx --tsconfig tsconfig.json scripts/setup-town-chain.ts",
    "check:screens": "node e2e/screens-check.cjs test-results/screens",
    "art:town": "blender -b -P art/blender/make_town.py -- .town.raw.glb art/town-preview.png && gltf-transform optimize .town.raw.glb public/models/town.glb --compress meshopt --join false --flatten false --instance false --palette false && rm .town.raw.glb",
    "check:voice": "tsx --tsconfig tsconfig.json scripts/voice-check.ts",
    "chain:cost": "tsx --tsconfig tsconfig.json scripts/chain-cost.ts",
    "treasury:key": "tsx scripts/treasury-key.ts",
    "proofs": "tsx --tsconfig tsconfig.json scripts/cheat-proofs.ts",
    "vercel-build": "pnpm db:migrate && next build"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@phala/dcap-qvl": "0.7.1",
    "@privy-io/react-auth": "3.51.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@solana/kit": "8.6.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "near-api-js": "7.5.3",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
