# Copy to .env.local (Next.js) and .env (scripts). See docs/SETUP.md.
# Every address, account and model is yours to set: the code assumes none.
DATABASE_URL=

# testnet or mainnet, and an RPC endpoint for that network.
NEAR_NETWORK=testnet
NEAR_RPC_URL=
NEAR_GAME_ACCOUNT=
NEAR_GAME_PRIVATE_KEY=
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_PRIVATE_KEY=
# Testnet faucet endpoint, only for the create/top-up testnet scripts.
NEAR_FAUCET_URL=
# Optional: block explorer base URL for links, e.g. <explorer>/address/<id>.
NEXT_PUBLIC_NEAR_EXPLORER_URL=

# NEAR AI Cloud (OpenAI compatible) base URL, the thinking model and the speech-to-text model.
NEAR_AI_URL=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_LISTEN_MODEL=

# NEAR Intents 1Click API base URL, optional partner key and referral tag.
ONECLICK_URL=
ONECLICK_JWT=
ONECLICK_REFERRAL=
# Mainnet account whose NEAR Intents balance receives top ups. pnpm treasury:key makes one (free).
TOPUP_TREASURY_ACCOUNT=

# ElevenLabs API base URL and key. Voices are picked live from its voice library;
# the speech model is ELEVENLABS_MODEL, or the cheapest speech model it lists.
ELEVENLABS_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=

NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Privy auth base URL (its JWKS lives at /api/v1/apps/<app id>/jwks.json).
PRIVY_AUTH_URL=

# 32 random bytes, base64: openssl rand -base64 32
SESSION_SECRET=
# 32 random bytes, base64. Encrypts the NEAR keys the game holds for players and slimes.
KEYS_SECRET=

# 1 enables a no-email test sign in. Ignored in production builds.
DEV_LOGIN=0
