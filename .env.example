# Copy to .env.local (Next.js) and .env (scripts). See docs/SETUP.md.
DATABASE_URL=postgres://slime:slime@localhost:5432/slimeworld

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_GAME_ACCOUNT=
NEAR_GAME_PRIVATE_KEY=
NEAR_RELAYER_ACCOUNT=
NEAR_RELAYER_PRIVATE_KEY=

NEAR_AI_API_KEY=
